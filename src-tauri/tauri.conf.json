{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GMD Medical Platform",
  "version": "0.1.1",
  "identifier": "com.gmdmedical.platform",
  "build": {
    "beforeDevCommand": "node scripts/dev/tauri-dev-with-api.mjs",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build/prepare-desktop-bundle.mjs",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GMD Medical Platform",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 768,
        "titleBarStyle": "Visible",
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": ["main"],
          "permissions": [
            "core:default",
            "dialog:default",
            "dialog:allow-ask",
            "dialog:allow-open",
            "dialog:allow-save",
            "fs:default",
            "fs:allow-mkdir",
            "fs:allow-exists",
            "fs:allow-copy-file",
            "fs:allow-rename",
            "fs:allow-remove",
            "fs:allow-write-file",
            {
              "identifier": "fs:scope",
              "allow": [
                {
                  "path": "**"
                },
                {
                  "path": "**/.*"
                },
                {
                  "path": "**/.*/**"
                }
              ]
            },
            "opener:default",
            {
              "identifier": "opener:allow-open-path",
              "allow": [
                {
                  "path": "**",
                  "app": true
                }
              ]
            },
            "sql:allow-load",
            "sql:allow-execute",
            "sql:allow-select",
            "sql:default"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../src/lib/templates/template_dislip.docx",
      "../desktop-runtime"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": [
        "sqlite:gmd.db"
      ]
    }
  }
}
